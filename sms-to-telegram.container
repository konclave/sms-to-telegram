[Unit]
Description=SMS to Telegram Proxy Container
OnFailure=quadlet-notify@%n.service
# A hung modem must not permanently stop the service. Disable systemd's start
# rate limit so restarts continue indefinitely; the backoff below keeps the
# retry (and its OnFailure alert) from flooding once the modem stays down.
StartLimitIntervalSec=0

[Container]
ContainerName=sms-to-telegram
Image=ghcr.io/konclave/sms-to-telegram:latest
EnvironmentFile=/etc/systemd-notify.env
Environment=DEVICE=/dev/ttyUSB0
Environment=QUEUE_ROOT=/var/spool/sms-forwarder
Environment=WORKER_PID_FILE=/var/run/sms-forwarder-worker.pid
Environment=ENQUEUE_LOG_PATH=/proc/1/fd/1
AddDevice=/dev/serial/by-id/usb-HUAWEI_Technologies_HUAWEI_Mobile-if00-port0:/dev/ttyUSB0
Volume=/var/lib/sms-to-telegram-queue:/var/spool/sms-forwarder:Z

[Service]
Restart=always
RestartSec=10
RestartSteps=10
RestartMaxDelaySec=1h

[Install]
WantedBy=multi-user.target default.target
